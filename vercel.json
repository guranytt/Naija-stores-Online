{
  "functions": {
    "api/**/*": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/product/:path*",
      "destination": "/api"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|product|vendor|assets|favicon.ico|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
