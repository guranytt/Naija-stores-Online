# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials (client-safe keys)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Resend Email Integration API Key
RESEND_API_KEY="re_your_api_key_here"

# Cloudinary CDN Configuration Connection URL
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Paystack API Settings (Secure Server-side Keys - Hide from client / bots)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_test_public_key"
VITE_PAYSTACK_LIVE_PUBLIC_KEY="pk_live_your_paystack_live_public_key"
PAYSTACK_SECRET_KEY="sk_test_..." # To verify payments securely from backend
VITE_PAYSTACK_ENV="test" # Choose 'test' or 'live'

# PostHog Analytics Client-safe Configuration
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Web Push Notifications VAPID Keys
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Clerk Authentication Configuration
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""



